# Set a long, unique secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Dashboard login password. Set this before exposing the dashboard.
ADMIN_PASSWORD=replace-with-a-strong-password
# SQLite database and rotating log paths
DATABASE_PATH=./data/retention.db
LOG_PATH=./logs/retention.log
# Worker polls the database for start/stop and schedule changes.
WORKER_POLL_SECONDS=5
# Dashboard defaults to localhost. Use a reverse proxy + HTTPS if remote access is needed.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
